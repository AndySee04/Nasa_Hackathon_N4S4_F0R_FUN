# Copy this file to backend/.env and fill in values. NEVER commit backend/.env.

# Optional AI model. Without a key, Astro runs in "knowledge mode" and answers only from the museum's
# verified data. Set ONE of the two keys below (if both are set, Anthropic is used).

# Option 1: Anthropic directly.
ANTHROPIC_API_KEY=
ASTRO_MODEL=claude-haiku-5-5

# Option 2: OpenRouter (https://openrouter.ai), one key for many models.
# Model ids: https://openrouter.ai/models. The default is the same Claude model via OpenRouter (paid credits).
# Free models end in ":free" (e.g. google/gemma-4-31b-it:free) but have tight rate limits, and some free
# providers may keep prompts for training. Children's questions are sent there, so for the live site prefer a
# paid model and turn off prompt training in OpenRouter's privacy settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Frontend origins allowed to call this API (comma-separated). Add your Vercel URL when deployed.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max Astro requests per minute from one IP address.
RATE_LIMIT_PER_MINUTE=20
LLM_TIMEOUT_SECONDS=20

# Most AI model calls per day (UTC), per server process. After that Astro answers in knowledge mode
# until midnight UTC, so a busy demo can't run up a bill. 0 = no cap.
LLM_DAILY_CAP=500

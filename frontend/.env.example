# URL of the FastAPI backend (no trailing slash). Public value: never put secrets in frontend env files.
VITE_API_URL=http://localhost:8000

# Optional: Google sign-in through Supabase. Leave both empty to switch accounts off (the site still works).
# Supabase Dashboard > Project Settings > API: the project URL and the publishable key (sb_publishable_…,
# or the legacy "anon" key). Both are public values. NEVER put the secret / service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
